# 发布包配置（与 TW ysname 相同：放在 config/application.yml）
# 复制为 config/application.yml 并修改数据库等信息
# 若同时使用 config/.env，.env 中的同名项优先级更高

server:
  port: 8080

spring:
  datasource:
    url: jdbc:mysql://127.0.0.1:3306/数据库名?allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&useUnicode=true&characterEncoding=UTF-8&useSSL=false&rewriteBatchedStatements=true
    username: 数据库用户名
    password: 数据库密码

  data:
    redis:
      host: 127.0.0.1
      port: 6379
      password:
      database: 0

# 管理员登录（对应 ysname 的 config/users.json）
app:
  admin:
    username: admin
    password: admin123

  jwt:
    secret: your-secret-key-change-in-production
    expiration: 3600000

# 日志
logging:
  file:
    name: logs/spglxt.log
    max-size: 20MB
    max-history: 30
