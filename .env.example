# ============================================
# 次元方舟视频管理系统 - Java版环境配置示例
# ============================================
# 复制此文件为 .env 并修改配置

# ============================================
# 应用配置
# ============================================
APP_NAME=次元方舟视频管理系统
APP_VERSION=1.0.0
SERVER_PORT=8080

# ============================================
# 数据库配置（连接苹果CMS数据库）
# ============================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cyfzdmw
DB_USER=cyfzdmw
DB_PASSWORD=XP5j4AbDiJNy87Fr
DB_CHARSET=UTF-8
DB_PREFIX=mac_

# 数据库连接池配置
DB_POOL_MIN_IDLE=5
DB_POOL_MAX_SIZE=20
DB_POOL_TIMEOUT=30000

# ============================================
# 管理员账户配置
# ============================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ============================================
# JWT 认证配置
# ============================================
JWT_SECRET=spglxt-video-system-jwt-secret-key-2024-change-in-production
JWT_EXPIRATION=604800000
# JWT过期时间: 604800000毫秒 = 7天

# ============================================
# Redis配置（用于Session存储）
# ============================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TIMEOUT=5000

# 是否启用Redis（如果没有Redis，设置为false，将使用内存存储）
USE_REDIS=false

# Go 启动器：指定 Java 路径（宝塔安装 JDK 后填写，例如 /www/server/java/jdk-17.0.8/bin）
# JAVA_HOME=/www/server/java/jdk-17.0.8

# ============================================
# Session配置
# ============================================
SESSION_TIMEOUT=30m
# Session超时时间: 30m = 30分钟

# ============================================
# 分页配置
# ============================================
PAGE_SIZE=20
PAGE_MAX_SIZE=100

# ============================================
# 时区设置
# ============================================
TIMEZONE=Asia/Shanghai

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=INFO
LOG_FILE=logs/spglxt.log
LOG_MAX_SIZE=10MB
LOG_MAX_HISTORY=30

# ============================================
# 文件上传配置
# ============================================
UPLOAD_MAX_FILE_SIZE=50MB
UPLOAD_MAX_REQUEST_SIZE=50MB

# ============================================
# 开发模式配置
# ============================================
# 开发模式下显示SQL语句
SHOW_SQL=true
# Thymeleaf模板缓存（开发时关闭）
TEMPLATE_CACHE=false
